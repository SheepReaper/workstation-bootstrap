$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
  - type: Microsoft.WinGet/Package
    name: vscode
    properties: { id: Microsoft.VisualStudioCode, source: winget, useLatest: true }
  - type: Microsoft.WinGet/Package
    name: dotnet-sdk
    properties: { id: Microsoft.DotNet.SDK.10, source: winget, useLatest: true }
  - type: Microsoft.WinGet/Package
    name: python
    properties: { id: Python.Python.3.13, source: winget, useLatest: true }
  - type: Microsoft.WinGet/Package
    name: nvm-windows
    properties: { id: CoreyButler.NVMforWindows, source: winget, version: 1.2.2 }
  - type: Microsoft.WinGet/Package
    name: docker
    properties: { id: Docker.DockerDesktop, source: winget, useLatest: true }
  - type: Microsoft.WinGet/Package
    name: wsl
    properties: { id: Microsoft.WSL, source: winget, useLatest: true }
  - type: Microsoft.WinGet/Package
    name: ubuntu
    properties: { id: Canonical.Ubuntu, source: winget, useLatest: true }
  - type: Microsoft.WinGet/Package
    name: ripgrep
    properties: { id: BurntSushi.ripgrep.MSVC, source: winget, useLatest: true }
  - type: Microsoft.WinGet/Package
    name: git-lfs
    properties: { id: GitHub.GitLFS, source: winget, useLatest: true }
  - type: Microsoft.WinGet/Package
    name: jq
    properties: { id: jqlang.jq, source: winget, useLatest: true }
