$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:
  - type: Microsoft.WinGet/Package
    name: sevenzip
    properties: { id: 7zip.7zip, source: winget, useLatest: true }
  - type: Microsoft.WinGet/Package
    name: wireshark
    properties: { id: WiresharkFoundation.Wireshark, source: winget, useLatest: true }
  - type: Microsoft.WinGet/Package
    name: cmake
    properties: { id: Kitware.CMake, source: winget, useLatest: true }
